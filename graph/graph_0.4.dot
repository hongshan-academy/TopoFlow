digraph G {
  "Left" [fillcolor=cadetblue, style=filled]
  "Right" [fillcolor=orange, style=filled]
  "Up" [fillcolor=orange, style=filled]
  "Down" [fillcolor=cadetblue, style=filled]
  "In" -> "Left" [label="f=0.400000", color=red]
  "Left" -> "Right" [label="f=1.000000", color=black]
  "Right" -> "Out" [label="f=0.400000", color=black]
  "Up" -> "Left" [label="f=0.200000", color=black]
  "Up" -> "Down" [label="f=0.200000", color=red]
  "Right" -> "Up" [label="f=0.400000", color=black]
  "Down" -> "Left" [label="f=0.400000", color=red]
  "Right" -> "Down" [label="f=0.200000", color=red]
}